DATABASE_URL=postgresql+psycopg://liftai:liftai@localhost:5433/liftai
SECRET_KEY=liftai-dev-secret-change-in-production
API_KEY=liftai-demo-key
LLM_PROVIDER=mock
# Compact local (Apple Silicon): pip install -r requirements-mlx.txt
# LLM_PROVIDER=mlx
# LLM_MODEL=mlx-community/Qwen3-4B-Instruct-4bit
# Smaller/faster: mlx-community/Qwen3-1.7B-4bit (~1 GB)
# Compact local (Ollama): ollama pull qwen3:4b
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b
LLM_MODEL=mlx-community/Qwen3-4B-Instruct-4bit
LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=                          # optional; required by some vLLM/SGLang deployments
# LLM_TIMEOUT=300                         # seconds; increase for large models on slow hardware
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.7
# LLM_THINK=false                         # Qwen3 thinking mode (Ollama only)
CORS_ORIGINS=["http://localhost:3000"]
REDDIT_ENABLED=true
REDDIT_RESULT_LIMIT=5
REDDIT_USER_AGENT=LiftAI/1.0 by u/liftai (lifting coach; contact: demo@liftai.app)
# Create a free "script" app at https://www.reddit.com/prefs/apps (required — public JSON is often blocked)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
